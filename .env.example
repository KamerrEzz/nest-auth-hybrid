NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

DATABASE_URL=postgresql://postgres:password@localhost:5432/authdb
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

SESSION_SECRET=set-a-secret
SESSION_MAX_AGE=604800000

RESEND_API_KEY=
FROM_EMAIL=noreply@example.com

# URL del frontend — usada en links de verificación de email y reset de contraseña
FRONTEND_URL=http://localhost:3001

# Clave de cifrado AES-256-GCM para secretos TOTP (64 caracteres hex = 32 bytes)
TOTP_ENC_KEY=

RATE_LIMIT_TTL=900000
RATE_LIMIT_MAX=100
BCRYPT_ROUNDS=12

GOOGLE_CLIENT_ID=changeme
GOOGLE_CLIENT_SECRET=changeme
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

DISCORD_CLIENT_ID=changeme
DISCORD_CLIENT_SECRET=changeme
DISCORD_CALLBACK_URL=http://localhost:3000/auth/discord/callback
# OAuth Provider (this server acts as OAuth provider)
SERVER_URL=http://localhost:3000
